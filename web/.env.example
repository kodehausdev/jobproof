# Jobproof engine base URL (dashboard feed: /api/dashboard/state + /events SSE)
NEXT_PUBLIC_ENGINE_URL=http://localhost:3000

# Supabase (durable audit trail + Realtime). Leave unset to fall back to the
# engine's live SSE feed only. Use the ANON key here, never service-role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — provisioning (create tenant/owner, onboarding routes) and the
# scripts/ CLI tools. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. STRIPE_PUBLISHABLE_KEY is the only one safe for the browser — it
# powers the embedded PaymentElement in the $0 card-on-file step
# (components/console/payment-gate.tsx).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# From `stripe listen` locally, or the dashboard endpoint config in prod.
STRIPE_WEBHOOK_SECRET=

# Resend — server-only. Team invites (Settings → Team → Invite) send their
# own email through this instead of Supabase's built-in mailer, which is
# rate-limited and was unreliable in practice (see lib/server/email.ts).
# FROM must be on a domain verified in the Resend account.
RESEND_API_KEY=
EMAIL_FROM=Jobproof <notifications@jobproof.ai>
